# Copy to .env in the project root (same folder as docker-compose.yml).
# NEVER commit the real .env to git.

# Password for the Postgres container. Pick a long random value:
#   openssl rand -base64 24
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Secret used to sign login sessions. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string

JWT_EXPIRES_IN=8h

# With Nginx proxying same-origin, CORS_ORIGIN mainly matters if you ever
# call the API from a different domain. Set it to your real domain once you
# have one; http://YOUR_SERVER_IP is fine before you've pointed a domain at it.
CORS_ORIGIN=http://YOUR_SERVER_IP

# Used once by backend/scripts/seed.js to build placeholder employee emails —
# update to your real company domain before seeding.
SEED_EMAIL_DOMAIN=yourcompany.com
